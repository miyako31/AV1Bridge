# Copy this file to .env and fill in real values.
# .env is read by docker-compose.yml; never commit it anywhere.

# Twitch dashboard -> Creator Dashboard -> Settings -> Stream -> Primary Stream key
TWITCH_STREAM_KEY=changeme

# Credentials your OBS "Custom" service authenticates with when publishing
# to this relay (on top of the RTMPS encryption itself). Pick your own
# random values -- this is what stops anyone who finds the open port from
# publishing garbage into your Twitch channel. These are NOT your Twitch key.
MTX_PUBLISH_USER=changeme
MTX_PUBLISH_PASS=changeme-too

# The host port OBS connects to (RTMPS). This is the only port you need
# to open in your cloud provider's firewall, besides SSH.
INGEST_PORT=1936

# --- TLS certificate (DuckDNS + Let's Encrypt, DNS-01 challenge) ---
# Used by scripts/issue-cert.sh and scripts/renew-cert.sh.
# DUCKDNS_DOMAIN: the full subdomain you registered, e.g. av1bridge.duckdns.org
# DUCKDNS_TOKEN: from your DuckDNS dashboard -- treat like a password
# CERT_EMAIL: contact address Let's Encrypt uses for expiry notices
DUCKDNS_DOMAIN=changeme.duckdns.org
DUCKDNS_TOKEN=changeme
CERT_EMAIL=changeme@example.com

# --- Software x264 transcode tuning ---
# Start conservative (a safe baseline for roughly 360p60), then push these
# up while watching `docker compose logs -f relay` for ffmpeg's speed=
# value. See README.md "Tuning" section for the full procedure.
X264_PRESET=veryfast
OUTPUT_VIDEO_BITRATE=2500k
OUTPUT_BUFSIZE=5000k
OUTPUT_KEYFRAME_INTERVAL=60

# Extra libx264 flags, appended after -preset/-threads. Empty by default.
# Use this to trade quality for encode speed beyond what X264_PRESET alone
# gives you, if CPU is still maxed out -- raise OUTPUT_VIDEO_BITRATE to
# compensate for the lost compression efficiency (Twitch allows up to
# ~6000k for non-partners). Space-separated, passed through as-is:
#   X264_EXTRA_PARAMS=-refs 1 -bf 0            # fewer reference frames, no B-frames
#   X264_EXTRA_PARAMS=-refs 1 -bf 0 -coder 0   # + CAVLC instead of CABAC (faster, less efficient)
# See README.md "Tuning" section for what each flag trades off.
X264_EXTRA_PARAMS=
